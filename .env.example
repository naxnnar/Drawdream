# DrawDream — คัดลอกไฟล์นี้เป็น `.env` ที่รากโปรเจกต์ (ห้าม commit `.env`)
# ค่าที่มีอยู่แล้วใน environment ของเซิร์ฟเวอร์จะไม่ถูกทับโดยไฟล์นี้

# production|prod — ปิดแสดง PHP error บนหน้าเว็บ (แนะนำบนโฮสจริง)
# APP_ENV=production

# --- MySQL (ถ้าไม่ใช้ config/db.local.php) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=drawdream_db

# --- Omise (Dashboard → API keys; Test = pkey_test_ / skey_test_) ---
OMISE_PUBLIC_KEY=pkey_test_your_public_key
OMISE_SECRET_KEY=skey_test_your_secret_key
OMISE_API_URL=https://api.omise.co

# Webhook: Omise Dashboard → Webhooks → signing secret (บังคับบน production)
OMISE_WEBHOOK_SECRET=whsec_your_signing_secret

# สุ่มสตริงยาว (openssl rand -hex 32) — ใช้กับ payment/cron_child_subscription_charges.php?secret=
DRAWDREAM_SUBSCRIPTION_CRON_SECRET=

# --- ตัวเลือก (true / false) ---
OMISE_ALLOW_LOCAL_MOCK=false
OMISE_TEST_MOCK_WHEN_HTTPS_FAILS=false
# โหมดทดสอบ: กดยืนยันการชำระแล้ว mark_as_paid อัตโนมัติ (ไม่มีผลกับคีย์ Live)
OMISE_TEST_AUTO_MARK_PAID=true

# --- Google OAuth (ถ้าไม่ใช้ config/google_oauth.local.php) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# local desktop: http://127.0.0.1:8080/auth/google_callback.php
# mobile (same Wi-Fi): http://YOUR_LAN_IP:8080/auth/google_callback.php — ต้องเพิ่มใน Google Console ด้วย
# production: https://your-domain/auth/google_callback.php
# บน dev/LAN ระบบใช้ redirect ตาม host ที่เปิดจริงอัตโนมัติ (ไม่ต้องเปลี่ยน .env ทุกครั้ง)
# GOOGLE_REDIRECT_URI=https://your-domain/auth/google_callback.php

# --- SSL สำหรับ cURL ไป Omise (ถ้า PHP ไม่มี CA ในระบบ) ---
# OMISE_CURL_CAINFO=C:/path/to/cacert.pem
